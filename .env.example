# Copy to .env and fill in real values. .env is gitignored -- never commit secrets.
#   docker compose --env-file .env up

# --- PostgreSQL ---
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filemanager_db

# --- S3-compatible storage (Garage) ---
# Generate with: docker compose exec garage /garage key create file-manager
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=files
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=us-east-1

# --- Garage node secrets ---
# openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
GARAGE_METRICS_TOKEN=change-me

# --- Application ---
# Set to true once the deployment terminates TLS.
COOKIE_SECURE=false
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=120MB
